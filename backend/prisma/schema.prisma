// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// TT-090: these columns held their allowed values only in a trailing comment, so Postgres
// accepted anything. A casing mismatch or a value invented by the AI pipeline created a
// row that every `status: 'open'` filter — the prior-context prompts, the project pulse,
// the allocation views — silently skipped, with no way to find it afterwards. As real
// enums the database refuses the bad value instead.
//
// Checked against production before writing these: every existing value is already one of
// the members below, so the cast applies cleanly. The AI-fed write paths normalise to
// these sets first (see lib/meetingContinuity.ts), so an unrecognised model answer becomes
// the sensible default rather than a runtime error.
enum MemberStatus {
  Active
  Benched
}

enum ActionItemStatus {
  open
  completed
  in_progress
  blocked
}

enum ActionItemPriority {
  high
  medium
  low
}

enum BlockerStatus {
  open
  resolved
}

enum PresalesTrack {
  PNB
  TNM
}

enum StageChangeSource {
  manual
  ai_suggested
}

// The stored values are hyphenated, so the enum members are mapped rather than renaming
// data that other tooling may already read.
enum EnrollmentType {
  assigned
  self_enrolled  @map("self-enrolled")
  auto_assigned  @map("auto-assigned")
}

enum RecordingType {
  file
  link
}

enum TranscriptSource {
  pasted
  uploaded_file
}

model TeamMember {
  id                   String   @id @default(cuid())
  name                 String
  email                String?  @unique
  phone                String?
  linkedinUrl          String?
  designation          String?
  joiningDate          DateTime
  skills               String[]
  profilePictureUrl    String?
  allocationPercentage Int      @default(100)
  status               MemberStatus @default(Active)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // CV fields (populated after CV upload + Groq extraction)
  skillsExtracted    Json? // Array of strings from Groq
  skillsGrouped      Json? // Array of grouped skills
  projectsExtracted  Json? // Array of projects
  yearsOfExperience  Int?
  cvSummary          String?
  atsScore           Int?
  atsScoreBreakdown  Json? // Detailed breakdown of the ATS score
  atsSuggestions     Json? // Array of string suggestions
  cvBlobUrl          String?
  cvOriginalFilename String?
  cvUploadedAt       DateTime?

  assignedCertifications AssignedCertification[]
  projectMembers         ProjectMember[]
  managedProjects        Project[]               @relation("ProjectManager")
  notifications          Notification[]
  taskAssignments        TaskAssignment[]
  taskFeedbacks          TaskFeedback[]          @relation("TaskFeedbackAssignee")
  projectUpdates         ProjectUpdate[]
  tasksRequested         Task[]                  @relation("TaskOnBehalfOf")
  meetingActionItems     MeetingActionItem[]
  keyDecisions           KeyDecision[]
  meetingAttendances     MeetingAttendee[]

  managerId    String?
  manager      TeamMember?  @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates TeamMember[] @relation("TeamManager")
  user         User?

  resumeProfiles   ResumeProfile[]
  generatedResumes GeneratedResume[]
  coeTickets       CoeTicket[]
  coeSessionAttendance CoeSessionAttendance[]
  learningProjectMemberships LearningProjectMember[]
  @@index([managerId])
  uploadedProjectFiles ProjectFile[] @relation("ProjectFileUploader")
  addedProjectLinks    ProjectLink[] @relation("ProjectLinkAuthor")

  @@map("team_members")
}

model Certification {
  id           String   @id @default(cuid())
  name         String
  provider     String
  description  String?
  duration     String?
  learningLink String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCertifications AssignedCertification[]
  // TT-093: the code treats a certification's name as identifying it — the seed looks it
  // up by name, and the GTM partner audit counts holders by matching
  // `certification.name`. Nothing stopped two rows with the same name and provider, and
  // production had eight rows where there should have been two: five people were counted
  // against five *different* catalog entries for the same certification, so the audit
  // undercounted and any name lookup bound to an arbitrary one.
  @@unique([name, provider])

  @@map("certifications")
}

// TT-019: foreign-key columns across most models had no index. Postgres does not create
// one for a foreign key, so every project and opportunity detail page, every
// meeting-minutes fetch and every task board was doing sequential scans that get slower
// in step with the table, and a cascading delete had to scan the children to find them.
model AssignedCertification {
  id               String              @id @default(cuid())
  memberId         String
  certificationId  String
  assignedDate     DateTime            @default(now())
  deadline         DateTime
  priority         Priority            @default(MEDIUM)
  notes            String?
  progress         Int                 @default(0)
  status           CertificationStatus @default(NOT_STARTED)
  completionDate   DateTime?
  expiryDate       DateTime?
  certificateUrl   String?
  credentialId     String?
  originalFilename String?
  uploadDate       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  member        TeamMember               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  certification Certification            @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  editRequests  CertificateEditRequest[]

  @@unique([memberId, certificationId])
  @@index([memberId, status])
  @@index([deadline])
  @@index([certificationId])
  @@map("assigned_certifications")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  client      String?
  startDate   DateTime
  endDate     DateTime?
  priority    Priority      @default(MEDIUM)
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0)
  visibleUntil DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members        ProjectMember[]
  managerId      String?
  manager        TeamMember?     @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  projectUpdates ProjectUpdate[]
  teamsMeetings  TeamsMeeting[]
  teamsChannelId String? // Optional channel ID for auto-syncing
  files          ProjectFile[]
  links          ProjectLink[]
  notes          ProjectNote[]
  meetingRecords MeetingRecord[]
  blockers       BlockerRisk[]
  tasks          Task[]

  @@index([status, endDate])
  @@index([managerId])
  @@map("projects")
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String?
  opportunityId String?
  memberId      String
  role          String?
  enrollmentType EnrollmentType? @default(assigned)
  joinedAt      DateTime @default(now())

  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity PreSalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  member      TeamMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  // TT-018: only the project half was constrained. This row is polymorphic, so the
  // opportunity half was unconstrained and the same member could be assigned to one
  // opportunity any number of times — inflating headcount, and making the
  // unassign-by-findFirst path remove an arbitrary one of the duplicates. Postgres
  // treats NULLs as distinct, so this constrains opportunity rows only, which is what is
  // wanted. Checked against production first: no existing duplicates to clean up.
  @@unique([opportunityId, memberId])
  @@index([memberId])
  @@map("project_members")
}

model ProjectUpdate {
  id            String   @id @default(cuid())
  projectId     String?
  opportunityId String?
  memberId      String
  updateText    String
  updateType    String // Progress / Blocker / Milestone / General
  progressValue Int?
  createdAt     DateTime @default(now())

  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity PreSalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  member      TeamMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([memberId])
  @@index([opportunityId])
  @@index([projectId])

  @@map("project_updates")
}

model Notification {
  id         String           @id @default(cuid())
  memberId   String? // set for member-targeted notifications
  targetRole String? // set for role-targeted notifications, e.g. "Admin"
  type       NotificationType
  title      String
  message    String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  member TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reads  NotificationRead[]

  @@index([memberId, createdAt])
  // TT-088: role-targeted notifications are unindexed free text and were filtered by it
  // on every request.
  @@index([targetRole, createdAt])
  @@map("notifications")
}

/// TT-088: `Notification.read` is one boolean shared by every recipient. A notification
/// addressed to a role goes to all admins, so the first admin to mark one read cleared it
/// from everyone else's unread count and panel — they never saw it. Read state is
/// per-person, so it needs a row per person.
///
/// The legacy `read` flag is deliberately kept and still honoured: a notification counts
/// as read for someone if that flag is set OR they have a row here. That preserves the
/// state already in the database — anything currently marked read stays read for
/// everyone, rather than a deploy resurfacing a pile of old notifications as unread.
/// Nothing sets the flag for role-targeted notifications any more.
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@map("notification_reads")
}

model Task {
  id          String     @id @default(cuid())
  taskNumber  Int        @default(autoincrement())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignedById String
  assignedBy   User   @relation(fields: [assignedById], references: [id])

  onBehalfOfId String?
  onBehalfOf   TeamMember? @relation("TaskOnBehalfOf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignments TaskAssignment[]
  feedbacks   TaskFeedback[]

  @@index([status])
  @@index([dueDate])
  @@index([assignedById])
  @@index([onBehalfOfId])
  @@index([projectId])
  @@map("tasks")
}

model TaskAssignment {
  id       String     @id @default(cuid())
  taskId   String
  task     Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status   TaskStatus @default(TODO)
  // TT-089: status is mutable and nothing recorded when it moved, so there was no way to
  // answer when an assignee finished a task — no throughput reporting, no stale-assignment
  // query, no audit of progress. Both default to now() so existing rows get a value;
  // createdAt is approximate for those and exact from here on.
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([taskId, memberId])
  @@index([memberId])
  @@map("task_assignments")
}

model TaskFeedback {
  id           String   @id @default(cuid())
  feedbackText String   @db.Text
  rating       Int? // 1-5, optional
  attachments  Json     @default("[]") // Array of { url: string, name: string }
  submittedAt  DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  assigneeId String
  assignee   TeamMember @relation("TaskFeedbackAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@unique([taskId, assigneeId])
  @@index([assigneeId])
  @@map("task_feedbacks")
}

model TeamsMeeting {
  id             String   @id @default(uuid())
  projectId      String?
  teamsMeetingId String
  subject        String
  organizer      String
  startTime      DateTime
  endTime        DateTime
  recordingUrl   String?
  transcriptText String?
  aiSummary      String?
  channelName    String?
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])

  @@map("teams_meetings")
}

model MeetingRecord {
  id               String    @id @default(cuid())
  projectId        String?
  opportunityId    String?
  meetingTitle     String
  meetingDate      DateTime?
  recordingType    RecordingType?
  recordingUrl     String?
  transcriptUrl    String?
  transcriptText   String?   @db.Text
  transcriptSource TranscriptSource?
  aiMinutes        Json?
  createdBy        String?
  createdAt        DateTime  @default(now())

  project          Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity      PreSalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actionItems      MeetingActionItem[]
  keyDecisions     KeyDecision[]
  blockersAndRisks BlockerRisk[]        @relation("MeetingBlockers")
  resolvedBlockers BlockerRisk[]        @relation("ResolvedInMeeting")
  attendees        MeetingAttendee[]

  @@index([projectId, meetingDate])
  @@index([opportunityId])
  @@map("meeting_records")
}

model MeetingActionItem {
  id                String    @id @default(cuid())
  meetingRecordId   String
  task              String    @db.Text
  originalOwnerText String
  assignedToId      String?
  dueDate           DateTime?
  completed         Boolean   @default(false)
  status            ActionItemStatus @default(open)
  priority          ActionItemPriority?
  confidence        String? // 'High' | 'Medium' | 'Low'
  sourceExcerpt     String?   @db.Text
  createdAt         DateTime  @default(now())

  meetingRecord MeetingRecord @relation(fields: [meetingRecordId], references: [id], onDelete: Cascade)
  assignedTo    TeamMember?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  @@index([assignedToId])
  @@index([meetingRecordId])

  @@map("meeting_action_items")
}

model KeyDecision {
  id              String  @id @default(cuid())
  meetingRecordId String
  decisionText    String  @db.Text
  context         String? @db.Text
  decidedById     String?
  confidence      String? // 'High' | 'Medium' | 'Low'
  sourceExcerpt   String? @db.Text

  createdAt DateTime @default(now())

  meetingRecord MeetingRecord @relation(fields: [meetingRecordId], references: [id], onDelete: Cascade)
  decidedBy     TeamMember?   @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  @@index([decidedById])
  @@index([meetingRecordId])

  @@map("key_decisions")
}

model BlockerRisk {
  id                   String  @id @default(cuid())
  projectId            String?
  opportunityId        String?
  description          String  @db.Text
  status               BlockerStatus @default(open)
  firstRaisedMeetingId String
  resolvedInMeetingId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  firstRaisedMeeting MeetingRecord  @relation("MeetingBlockers", fields: [firstRaisedMeetingId], references: [id], onDelete: Cascade)
  resolvedInMeeting  MeetingRecord? @relation("ResolvedInMeeting", fields: [resolvedInMeetingId], references: [id], onDelete: SetNull)
  @@index([firstRaisedMeetingId])
  @@index([projectId])
  @@index([resolvedInMeetingId])

  @@map("blockers_risks")
}

model MeetingAttendee {
  id              String  @id @default(cuid())
  meetingRecordId String
  memberId        String?
  rawName         String

  createdAt DateTime @default(now())

  meetingRecord MeetingRecord @relation(fields: [meetingRecordId], references: [id], onDelete: Cascade)
  member        TeamMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  @@index([meetingRecordId])
  @@index([memberId])

  @@map("meeting_attendees")
}

// Enums

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CertificationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  EXPIRED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum CoeTrack {
  DATABRICKS
  FABRIC
  FDE
}

enum CoeTicketStatus {
  BACKLOG
  IN_PROGRESS
  DONE
}

enum CoeTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum CoeSessionStatus {
  SCHEDULED
  ENDED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NotificationType {
  CERTIFICATION_ASSIGNED
  DEADLINE_APPROACHING
  CERTIFICATE_UPLOADED
  CERTIFICATION_COMPLETED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ASSIGNED
  PROJECT_AUTO_ASSIGNED
  CERTIFICATE_EDIT_REQUESTED
  NEW_MEMBER_REGISTERED
  TASK_ASSIGNED
  TASK_DUE_SOON
  COE_SESSION_SCHEDULED
  COE_SESSION_REMINDER_DAY
  COE_SESSION_REMINDER_30_MIN
  COE_SESSION_ABSENCE_REPORTED
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PreSalesOpportunity {
  id                String   @id @default(cuid())
  name              String
  clientName        String
  description       String?  @db.Text
  account           PresalesTrack
  stages            String[]
  currentStageIndex Int      @default(0)
  progressPercent   Int      @default(0) // 0-100, continuous progress (AI-driven or stage-boundary on manual click)

  // ── Proposal Summary ────────────────────────────────────────────────────────
  // These nine columns are populated ONLY by POST /:id/generate-proposal.
  // They are NEVER touched by PATCH /:id/stage, PATCH /:id/progress, or POST /:id/reset —
  // those routes only update currentStageIndex and/or progressPercent.
  executiveSummary       String?   @db.Text
  scopeOfWork            String?   @db.Text
  architecture           String?   @db.Text
  implementationApproach String?   @db.Text
  deliveryApproach       String?   @db.Text
  assumptions            String?   @db.Text
  outOfScope             String?   @db.Text
  timelines              String?   @db.Text
  commercials            String?   @db.Text
  others                 String?   @db.Text
  sourceDocuments        Json? // array of { fileName, blobUrl, uploadedAt }
  descriptionGeneratedAt DateTime?

  // TT-051: conversion to a Project was not recorded anywhere, so calling the endpoint
  // twice created a second Project and re-pointed the same child rows at it. Set inside
  // the conversion transaction; its presence is what makes a repeat call a 409.
  convertedProjectId     String?
  // ────────────────────────────────────────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates        ProjectUpdate[]
  assignments    ProjectMember[]
  stageChangeLogs StageChangeLog[]
  files          ProjectFile[]
  links          ProjectLink[]
  notes          ProjectNote[]
  meetingRecords MeetingRecord[]

  @@map("presales_opportunities")
}

model GtmPlan {
  id                String   @id @default(cuid())
  name              String
  clientName        String
  category          String // 'NEW_MARKET_ENTRY' or 'EXISTING_CLIENT_EXPANSION'
  stages            String[]
  currentStageIndex Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaigns GtmCampaign[]
  files     GtmCollateral[]

  @@map("gtm_plans")
}

model GtmPartner {
  id          String   @id @default(cuid())
  name        String
  tier        String // e.g. Gold Partner, Select Partner
  renewalDate DateTime @map("renewal_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requirements GtmPartnerRequirement[]
  campaigns    GtmCampaign[]
  files        GtmCollateral[]

  @@map("gtm_partners")
}

model GtmPartnerRequirement {
  id                String   @id @default(cuid())
  partnerId         String   @map("partner_id")
  certificationName String   @map("certification_name")
  minimumCount      Int      @map("minimum_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  partner GtmPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  @@index([partnerId])

  @@map("gtm_partner_requirements")
}

model GtmCampaign {
  id          String    @id @default(cuid())
  name        String
  launchId    String?   @map("launch_id")
  partnerId   String?   @map("partner_id")
  status      String // 'Planned' | 'Active' | 'Completed'
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  launch  GtmPlan?    @relation(fields: [launchId], references: [id], onDelete: SetNull)
  partner GtmPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  @@index([launchId])
  @@index([partnerId])

  @@map("gtm_campaigns")
}

model GtmCollateral {
  id         String   @id @default(cuid())
  name       String
  url        String
  type       String
  size       Int
  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  launchId   String?  @map("launch_id")
  partnerId  String?  @map("partner_id")

  launch  GtmPlan?    @relation(fields: [launchId], references: [id], onDelete: SetNull)
  partner GtmPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  @@index([launchId])
  @@index([partnerId])

  @@map("gtm_collaterals")
}

model StageChangeLog {
  id               String   @id @default(cuid())
  opportunityId    String // The specific PreSalesOpportunity row ID
  track            PresalesTrack
  previousStage    String
  newStage         String
  source           StageChangeSource
  reasoning        String? // Groq's reasoning field (only for ai_suggested)
  blobUrl          String? // URL of the uploaded document (only for ai_suggested)
  originalFilename String? // The actual original file name of the document
  createdAt        DateTime @default(now())

  // TT-091: opportunityId was an unconstrained string. Nothing stopped a log row pointing
  // at an opportunity that never existed, deleting an opportunity left its audit rows
  // orphaned for good, and reading one opportunity's history scanned the whole table.
  // Checked against production first: no orphaned rows to clean up.
  opportunity PreSalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("stage_change_logs")
}

model ProjectFile {
  id            String   @id @default(cuid())
  projectId     String?
  opportunityId String?
  name          String
  url           String
  type          String
  size          Int
  // TT-092: this held a team-member id as a bare string with no foreign key, so deleting
  // a member left a dangling reference the UI silently rendered as nobody. It is a real
  // relation now, and nullable: SetNull keeps the record when the member goes rather than
  // blocking the deletion or taking the file with it. Null also carries meaning — see the
  // system-generated case in routes/presales.ts.
  uploadedBy    String?
  uploadedAt    DateTime @default(now())

  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity PreSalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  uploader    TeamMember?          @relation("ProjectFileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  @@index([opportunityId])
  @@index([projectId])
  @@index([uploadedBy])

  @@map("project_files")
}

model ProjectLink {
  id            String   @id @default(cuid())
  projectId     String?
  opportunityId String?
  title         String
  url           String
  description   String?
  // Same as ProjectFile.uploadedBy above (TT-092).
  addedBy       String?
  addedAt       DateTime @default(now())

  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity PreSalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      TeamMember?          @relation("ProjectLinkAuthor", fields: [addedBy], references: [id], onDelete: SetNull)
  @@index([opportunityId])
  @@index([projectId])
  @@index([addedBy])

  @@map("project_links")
}

model ProjectNote {
  id            String   @id @default(cuid())
  projectId     String?
  opportunityId String?
  title         String
  content       String   @db.Text
  // Same as ProjectFile.uploadedBy above (TT-092). Note that an admin without a team
  // member record writes their user id here, so this does not always resolve.
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity PreSalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([opportunityId])
  @@index([projectId])
  @@index([updatedBy])

  @@map("project_notes")
}

model CertificateEditRequest {
  id              String            @id @default(cuid())
  assignmentId    String
  proposedChanges Json // { completionDate?, expiryDate?, credentialId? }
  requestedBy     String // display name of requester
  status          EditRequestStatus @default(PENDING)
  reviewedBy      String?
  reviewNotes     String?
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?

  assignment AssignedCertification @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  @@index([assignmentId])

  @@map("certificate_edit_requests")
}

model ActivityLog {
  id          String   @id @default(cuid())
  category    String // e.g., 'Certificate', 'CV', 'GTM', 'Project'
  action      String // e.g., 'UPLOAD', 'DELETE', 'UPDATE', 'CREATE'
  details     String   @db.Text
  // TT-092: performedBy holds the actor's display *name*, so renaming someone leaves
  // stale names scattered through the audit trail and "everything X did" cannot be
  // answered reliably — two people sharing a name are indistinguishable.
  //
  // The name stays: an audit entry should record what was true at the time, and it must
  // survive the actor's account being deleted. What is added is a reference alongside it,
  // nullable because system-performed actions have no user and because SetNull keeps the
  // log intact when an account goes.
  performedBy   String  @default("System")
  performedById String?
  performedByUser User? @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  @@index([performedById])

  @@map("activity_logs")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json // { "read": true, "write": true, "delete": false, "manageTeam": false }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  roleId             String
  teamMemberId       String?  @unique
  mustChangePassword Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  role       Role        @relation(fields: [roleId], references: [id])
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  tasks      Task[]
  coeResources CoeLearningResource[]
  coeTickets   CoeTicket[] @relation("CoeTicketCreator")
  coeKnowledgeSessions CoeKnowledgeSession[] @relation("CoeSessionOrganizer")
  coeSessionMeetingNotes CoeSessionMeetingNote[]
  notificationReads      NotificationRead[]
  activityLogs           ActivityLog[]
  learningProjects LearningProject[] @relation("LearningProjectCreator")
  learningProjectUpdates LearningProjectMilestoneUpdate[] @relation("LearningProjectUpdateCreator")
  learningProjectAssets LearningProjectAsset[] @relation("LearningProjectAssetUploader")
  @@index([roleId])

  @@map("users")
}

model LearningProject {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // TT-020: this and six sibling relations were onDelete: Cascade, so deleting one User
  // row silently destroyed the shared content they happened to have created — entire
  // learning projects with their members, milestones and assets, the CoE knowledge base,
  // every ticket they filed and every session they scheduled. Offboarding one person
  // could take a chunk of the organisation's record with it. Restrict makes such a delete
  // fail loudly; deactivation already has a proper route through User.isActive.
  createdBy  User                       @relation("LearningProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members    LearningProjectMember[]
  milestones LearningProjectMilestone[]
  assets     LearningProjectAsset[]

  @@index([createdById, updatedAt])
  @@map("learning_projects")
}

model LearningProjectMember {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  addedAt   DateTime @default(now())

  project LearningProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
  @@map("learning_project_members")
}

model LearningProjectMilestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project LearningProject                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updates LearningProjectMilestoneUpdate[]

  @@index([projectId, createdAt])
  @@map("learning_project_milestones")
}

model LearningProjectMilestoneUpdate {
  id          String   @id @default(cuid())
  milestoneId String
  body        String   @db.Text
  createdById String
  createdAt   DateTime @default(now())

  milestone LearningProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdBy User                     @relation("LearningProjectUpdateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([milestoneId, createdAt])
  @@index([createdById])
  @@map("learning_project_milestone_updates")
}

model LearningProjectAsset {
  id           String   @id @default(cuid())
  projectId    String
  kind         String
  label        String
  url          String?
  fileUrl      String?
  fileName     String?
  mimeType     String?
  uploadedById String
  createdAt    DateTime @default(now())

  project    LearningProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("LearningProjectAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([uploadedById])
  @@map("learning_project_assets")
}

model CoeLearningResource {
  id            String   @id @default(cuid())
  track         CoeTrack
  title         String
  description   String?
  fileName      String
  fileUrl       String
  fileMimeType  String?
  uploadedById  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([track, createdAt])
  @@index([uploadedById])
  @@map("coe_learning_resources")
}

model CoeTicket {
  id          String            @id @default(cuid())
  ticketNumber Int              @unique @default(autoincrement())
  track       CoeTrack
  title       String
  description String?           @db.Text
  status      CoeTicketStatus   @default(IN_PROGRESS)
  priority    CoeTicketPriority @default(MEDIUM)
  createdById String
  memberId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdBy User        @relation("CoeTicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  member    TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([track, status])
  @@index([memberId])
  @@index([createdById])
  @@map("coe_tickets")
}

model CoeKnowledgeSession {
  id                    String           @id @default(cuid())
  topic                 String
  description           String?          @db.Text
  scheduledAt           DateTime
  durationMinutes       Int              @default(60)
  status                CoeSessionStatus @default(SCHEDULED)
  organizerId           String
  endedAt               DateTime?
  attendanceSummary     String?          @db.Text
  meetingNotesFileName  String?
  meetingNotesFileUrl   String?
  meetingNotesMimeType  String?
  transcriptFileName    String?
  transcriptFileUrl     String?
  transcriptMimeType    String?
  transcriptText        String?          @db.Text
  transcriptSummary     String?          @db.Text
  dayReminderSentAt     DateTime?
  thirtyMinuteReminderSentAt DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organizer   User                   @relation("CoeSessionOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  attendance  CoeSessionAttendance[]
  meetingNotes CoeSessionMeetingNote[]

  @@index([status, scheduledAt])
  @@index([organizerId])
  @@map("coe_knowledge_sessions")
}

model CoeSessionMeetingNote {
  id          String   @id @default(cuid())
  sessionId   String
  fileName    String
  fileUrl     String
  mimeType    String?
  uploadedById String
  createdAt   DateTime @default(now())

  session    CoeKnowledgeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([uploadedById])
  @@map("coe_session_meeting_notes")
}

model CoeSessionAttendance {
  id          String   @id @default(cuid())
  sessionId   String
  memberId    String
  attended    Boolean  @default(false)
  notes       String?
  updatedAt   DateTime @updatedAt

  session CoeKnowledgeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  TeamMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@map("coe_session_attendance")
}

model ResumeProfile {
  id       String     @id @default(cuid())
  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  atsScore       Int?
  atsBreakdown   Json?
  atsSuggestions Json?

  summary           String?
  skills            Json?
  skillsGrouped     Json?
  projects          Json?
  primaryRole       String?
  yearsOfExperience Int?
  certifications    Json?
  rawExtractedText  String?

  uploadedAt DateTime @default(now())

  @@index([memberId])
  @@map("resume_profiles")
}

model GeneratedResume {
  id       String     @id @default(cuid())
  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  jobDescription  String?
  tailoredContent Json
  pdfUrl          String?

  createdAt DateTime @default(now())

  @@index([memberId])
  @@map("generated_resumes")
}
