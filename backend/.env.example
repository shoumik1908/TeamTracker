# Environment Variables - Backend
# Copy this file to .env and fill in your values

# Database - Supabase PostgreSQL (any PostgreSQL 16 instance works locally)
# DIRECT_URL is required: schema.prisma declares directUrl, and Prisma uses it
# for migrations and other DDL. Use the direct/session connection for it — the
# transaction pooler can stall admin queries.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_ACCOUNT_NAME="your-storage-account-name"

# Blob Containers
AZURE_CONTAINER_CERTIFICATES="certificates"
AZURE_CONTAINER_PROFILE_IMAGES="profile-images"
AZURE_CONTAINER_PROJECT_DOCS="project-documents"
AZURE_CONTAINER_REPORTS="reports"

# Auth — REQUIRED. The server refuses to start without it.
# Generate a fresh value: openssl rand -base64 48
JWT_SECRET="generate-your-own-do-not-reuse-this-line"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Primary AI Provider (Groq)
GROQ_API_KEY="your-groq-api-key"

# Secondary AI Provider Fallback (Azure OpenAI)
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="your-deployment-name"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# TT-069: the session is an httpOnly cookie. 'lax' is correct when the frontend reaches
# the API on its own origin, which is what the rewrite in frontend/vercel.json arranges.
# Set to 'none' only if the API is addressed directly on another origin — note Safari
# restricts that case.
AUTH_COOKIE_SAMESITE=lax
